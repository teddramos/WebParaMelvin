@model WebParaMelvin.Models.Apnea

@{
    ViewBag.Title = "Edit";
    WebParaMelvin.Models.ceisamco_form_s_oEntities db = new WebParaMelvin.Models.ceisamco_form_s_oEntities();

    var fso = db.Formulario_S_O.FirstOrDefault(f => f.Id_Formulario_S_O == Model.Id_Formulario_S_O);
    var info = db.Info_general.FirstOrDefault(l => l.Id_Formulario_S_O == Model.Id_Formulario_S_O);
    var cso = db.CSOes.FirstOrDefault(c => c.Id_Formulario_S_O == Model.Id_Formulario_S_O);
}

<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>Edit</title>
    <style>
        .label-form{
            font-weight:bold;
        }
    </style>
</head>
<body>
    <table style="width:100%;">
        <tr>
            <td colspan="5">&nbsp;</td>
            <td><strong>expediente No.</strong></td>
            <td class="form-control">&nbsp;&nbsp;@fso.Id_Formulario_S_O</td>
        </tr>
        <tr>
            <td><strong>Empresa:</strong></td>
            <td class="form-control" colspan="4">@fso.Empresa.Nombre</td>
            <td><strong>Fecha:</strong></td>
            <td class="form-control">&nbsp;&nbsp;@info.Fecha</td>
        </tr>
        <tr>
            <td><strong>Departamento:</strong></td>
            <td class="form-control">&nbsp;@info.Departamento</td>
            <td><strong>Posicion:</strong></td>
            <td class="form-control" colspan="4">&nbsp;&nbsp;@info.Posicion</td>
        </tr>
        <tr>
            <td><strong>Tipo evaluacion:</strong></td>
            <td class="form-control" colspan="6">&nbsp;&nbsp;@info.Tipo_de_evaluacion</td>
        </tr>
        <tr>
            <td colspan="7">&nbsp;</td>
        </tr>
        <tr>
            <td colspan="7"><h3>Datos Generales</h3><hr /></td>
        </tr>
        <tr>
            <td><strong>Nombre:</strong></td>
            <td class="form-control" colspan="2">@info.Nombre&nbsp;&nbsp;@info.Apellido</td>
            <td><strong>Sexo:</strong></td>
            <td class="form-control">@info.Sexo</td>
            <td><strong>Cedula:</strong></td>
            <td class="form-control">&nbsp;&nbsp;@info.Cedula</td>
        </tr>
        <tr>
            <td><strong>Fecha de Nacimiento:</strong></td>
            <td class="form-control">@info.Fecha_de_nacimiento.Value.ToShortDateString()</td>
            <td><strong>Edad:</strong></td>
            <td class="form-control">@info.Edad</td>
            <td><strong>Id Empleado:</strong></td>
            <td class="form-control" colspan="2">@info.Id_Empleado</td>
        </tr>
    </table>
    @using (Html.BeginForm())
    {
        @Html.AntiForgeryToken()

<div class="form-horizontal">
    <h4>Detección de Síndrome de Apnea del Sueño</h4>
    <hr />
    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
    @Html.HiddenFor(model => model.Id_Apnea)
    @Html.HiddenFor(model => model.Id_Formulario_S_O)

    <h4>1. FILIACION</h4>
    <hr />
    <table>
        <tr>
            <td class="label-form">DNI</td>
            <td>@info.Cedula</td>
            <td colspan="2"><span class="label-form">F. Nacimiento:</span> @info.Fecha_de_nacimiento.Value.ToShortDateString()</td>
            <td class="label-form">Sexo</td>
            <td colspan="2">
                @if (info.Sexo == "Masculino")
                {<span>M</span><input type="radio" checked disabled />
                }
                else
                { <span>M</span><input type="radio" disabled />}
                @if (info.Sexo != "Masculino")
                {<span>F</span><input type="radio" checked disabled />
                }
                else
                { <span>F</span><input type="radio" disabled />}
            </td>
        </tr>
        <tr>
            <td colspan="2" class="label-form">Area de trabajo:</td>
            <td colspan="2">@cso.Área_de_Trabajo</td>
            <td colspan="2" class="label-form">Tipo Licencia:</td>
            <td> @Html.EditorFor(model => model.Tipo_licencia, new { htmlAttributes = new { @class = "form-control" } })</td>
        </tr>
        <tr>
            <td colspan="2" class="label-form">Empresa</td>
            <td colspan="4"> @fso.Empresa.Nombre</td>
        </tr>
        <tr>
            <td colspan="2" class="label-form">Trabaja de noche</td>
            <td>
                @if (Model.Trabaja_de_noche)
                {<span>SI</span><input type="radio" name="Trabaja_de_noche" value="true" checked /> <span>NO</span><input type="radio" name="Trabaja_de_noche" value="false" /> }
                else
                {<span>SI</span><input type="radio" name="Trabaja_de_noche" value="true" /> <span>NO</span><input type="radio" name="Trabaja_de_noche" value="false" checked />}
            </td>
            <td class="label-form"># dias de trabajo:</td>
            <td> @Html.EditorFor(model => model.Dias_trabajo, new { htmlAttributes = new { @class = "form-control" } })</td>
            <td colspan="2" class="label-form"># dias de descanso:</td>
            <td>  @Html.EditorFor(model => model.Dias_descanso, new { htmlAttributes = new { @class = "form-control" } })</td>
        </tr>
        <tr>
            <td colspan="3" class="label-form">
                Años que trabaja en dicho horario de trabajo:
            </td>
            <td colspan="4">@cso.Antiguedad_en_el_puesto</td>
        </tr>
    </table>
    <br />
    @* Antecedentes personales... *@

    <h4>2. ANTECEDENTES PERSONALES</h4>
    <hr />
    <table>
        <tr>
            <td class="label-form" colspan="2">Ápnea del sueño</td>
            <td colspan="2">
                @if (Model.Apnea_del_sueno)
                {<span>SI</span><input type="radio" name="Apnea_del_sueno" value="true" checked /> <span>NO</span><input type="radio" name="Apnea_del_sueno" value="false" /> }
                else
                {<span>SI</span><input type="radio" name="Apnea_del_sueno" value="true" /> <span>NO</span><input type="radio" name="Apnea_del_sueno" value="false" checked />}
            </td>
            <td class="label-form">Último control:</td>
            <td> @Html.EditorFor(model => model.Ultimo_control, new { htmlAttributes = new { @class = "form-control", @type = "date" } })</td>
        </tr>
        <tr>
            <td class="label-form">HTA</td>
            <td>
                @if (Model.HTA)
                {<span>SI</span><input type="radio" name="HTA" value="true" checked /> <span>NO</span><input type="radio" name="HTA" value="false" /> }
                else
                {<span>SI</span><input type="radio" name="HTA" value="true" /> <span>NO</span><input type="radio" name="HTA" value="false" checked />}
            </td>
            <td class="label-form">Medicación: (riesgo >2)</td>
            <td colspan="5"> @Html.EditorFor(model => model.Medicacion, new { htmlAttributes = new { @class = "form-control" } })</td>
        </tr>
        <tr>
            <td class="label-form" colspan="2">Polisomnografía (PSG) realizada alguna vez: </td>
            <td>
                @if (Model.Polisomnografía_PSG)
                {<span>SI</span><input type="radio" name="Polisomnografía_PSG" value="true" checked /> <span>NO</span><input type="radio" name="Polisomnografía_PSG" value="false" /> }
                else
                {<span>SI</span><input type="radio" name="Polisomnografía_PSG" value="true" /> <span>NO</span><input type="radio" name="Polisomnografía_PSG" value="false" checked />}
            </td>
            <td class="label-form">
                Fecha de última PSG:
            </td>
            <td colspan="2">  @Html.EditorFor(model => model.Fecha_ultima_PSG, new { htmlAttributes = new { @class = "form-control", @type = "date" } })</td>
        </tr>
        <tr>
            <td class="label-form" colspan="2">Antecedente de choque de vehículo:</td>
            <td class="label-form">
                <div>En mina:</div>
                <div>(si es NO, pase a sección 4)</div>
            </td>
            <td>
                @if (Model.En_mina)
                {<span>SI</span><input type="radio" name="En_mina" value="true" checked /> <span>NO</span><input type="radio" name="En_mina" value="false" /> }
                else
                {<span>SI</span><input type="radio" name="En_mina" value="true" /> <span>NO</span><input type="radio" name="En_mina" value="false" checked />}
            </td>
            <td class="label-form">
                <div>Fuera de mina:</div>
                <div>(si es NO, pase a sección 4)</div>
            </td>
            <td>
                @if (Model.Fuera_de_mina)
                {<span>SI</span><input type="radio" name="Fuera_de_mina" value="true" checked /> <span>NO</span><input type="radio" name="Fuera_de_mina" value="false" /> }
                else
                {<span>SI</span><input type="radio" name="Fuera_de_mina" value="true" /> <span>NO</span><input type="radio" name="Fuera_de_mina" value="false" checked />}
            </td>
        </tr>
    </table>
    <br />
    <h4>Detalle lo siguiente de los antecedentes del (los) choques (incidentes o accidentes):</h4>
    <hr />

    @* detalle lo siguiente *@
    <table>
        <tr>
            <td colspan="2"></td>
            <td style="padding-right:5px;padding-left:5px" class="label-form">SI</td>
            <td style="padding-right:5px;padding-left:5px" class="label-form">NO</td>
        </tr>
        <tr>
            <td class="label-form" width="80">Criterio 1</td>
            <td>
                Se “cabeceó” y por ello le ocurrió un accidente (incidente) con un vehículo
                (alguna vez)
            </td>
            <td>
                @if (Model.Se_cabeceo)
                {<input type="radio" name="Se_cabeceo" value="true" checked />}
                else
                {<input type="radio" name="Se_cabeceo" value="true" />}
            </td>
            <td>
                @if (!Model.Se_cabeceo)
                {<input type="radio" name="Se_cabeceo" value="false" checked />}
                else
                {<input type="radio" name="Se_cabeceo" value="false" />}
            </td>
        </tr>
        <tr>
            <td class="label-form">
                Criterio 2
            </td>
            <td>(2 o más es positivo)</td>
            <td></td>
            <td></td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                Accidente ocurrido en las últimas 5 horas de un turno nocturno o entre las 14 y 17 horas (tarde)
            </td>
            <td>
                @if (Model.Accidente_en_ultimas_5_horas)
                {<input type="radio" name="Accidente_en_ultimas_5_horas" value="true" checked />}
                else
                {<input type="radio" name="Accidente_en_ultimas_5_horas" value="true" />}
            </td>
            <td>
                @if (!Model.Se_cabeceo)
                {<input type="radio" name="Accidente_en_ultimas_5_horas" value="false" checked />}
                else
                {<input type="radio" name="Accidente_en_ultimas_5_horas" value="false" />}
            </td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                AUSENCIA DE evidencia de maniobra evasiva del chofer para evitar la colisión
            </td>
            <td>
                @if (Model.Ausencia_de_evidencia_de_maniobra)
                {<input type="radio" name="Ausencia_de_evidencia_de_maniobra" value="true" checked />}
                else
                {<input type="radio" name="Ausencia_de_evidencia_de_maniobra" value="true" />}
            </td>
            <td>
                @if (!Model.Ausencia_de_evidencia_de_maniobra)
                {<input type="radio" name="Ausencia_de_evidencia_de_maniobra" value="false" checked />}
                else
                {<input type="radio" name="Ausencia_de_evidencia_de_maniobra" value="false" />}
            </td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                Colisión frontal del vehículo contra otro, cayó a un precipicio, río o chocó contra un poste, puente, edificio u otra estructura estática sin motivo aparente
            </td>
            <td>
                @if (Model.Colision_frontal_del_vehiculo)
                {<input type="radio" name="Colision_frontal_del_vehiculo" value="true" checked />}
                else
                {<input type="radio" name="Colision_frontal_del_vehiculo" value="true" />}
            </td>
            <td>
                @if (!Model.Colision_frontal_del_vehiculo)
                {<input type="radio" name="Colision_frontal_del_vehiculo" value="false" checked />}
                else
                {<input type="radio" name="Colision_frontal_del_vehiculo" value="false" />}
            </td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                Vehículo que invadió el otro carril o se desvió sin causa aparente
            </td>
            <td>
                @if (Model.Vehiculo_que_invadio)
                {<input type="radio" name="Vehiculo_que_invadio" value="true" checked />}
                else
                {<input type="radio" name="Vehiculo_que_invadio" value="true" />}
            </td>
            <td>
                @if (!Model.Colision_frontal_del_vehiculo)
                {<input type="radio" name="Vehiculo_que_invadio" value="false" checked />}
                else
                {<input type="radio" name="Vehiculo_que_invadio" value="false" />}
            </td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                El conductor no recuerda claramente lo ocurrido 10 segundos antes del impacto
            </td>
            <td>
                @if (Model.El_conductor_no_recuerda)
                {<input type="radio" name="El_conductor_no_recuerda" value="true" checked />}
                else
                {<input type="radio" name="El_conductor_no_recuerda" value="true" />}
            </td>
            <td>
                @if (!Model.El_conductor_no_recuerda)
                {<input type="radio" name="El_conductor_no_recuerda" value="false" checked />}
                else
                {<input type="radio" name="El_conductor_no_recuerda" value="false" />}
            </td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                El conductor tomó alguna medicación o recientemente terminó un tratamiento con medicinas que causan somnolencia (benzodiacepinas, antihistamínicos, relajantes musculares o antidepresivos, etc)
            </td>
            <td>
                @if (Model.El_conductor_tomo_una_medicacion)
                {<input type="radio" name="El_conductor_tomo_una_medicacion" value="true" checked />}
                else
                {<input type="radio" name="El_conductor_tomo_una_medicacion" value="true" />}
            </td>
            <td>
                @if (!Model.El_conductor_tomo_una_medicacion)
                {<input type="radio" name="El_conductor_tomo_una_medicacion" value="false" checked />}
                else
                {<input type="radio" name="El_conductor_tomo_una_medicacion" value="false" />}
            </td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                El conductor se encontraba en horas extra (excediendo sus horas habituales de trabajo) o realizando días adicionales de trabajo (sobretiempo)
            </td>
            <td>
                @if (Model.El_conductor_se_encontraba_en_horas_extras)
                {<input type="radio" name="El_conductor_se_encontraba_en_horas_extras" value="true" checked />}
                else
                {<input type="radio" name="El_conductor_se_encontraba_en_horas_extras" value="true" />}
            </td>
            <td>
                @if (!Model.El_conductor_se_encontraba_en_horas_extras)
                {<input type="radio" name="El_conductor_se_encontraba_en_horas_extras" value="false" checked />}
                else
                {<input type="radio" name="El_conductor_se_encontraba_en_horas_extras" value="false" />}
            </td>
        </tr>
        <tr>
            <td colspan="2" class="label-form">Clasificación del (los) “Choques” o accidentes vehiculares del postulante</td>
            <td class="label-form">SI</td>
            <td class="label-form">NO</td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                Accidente confirmado por Somnolencia (Criterio 1 positivo)
            </td>
            <td>
                @if (Model.Accidente_por_somnolencia)
                {<input type="radio" name="Accidente_por_somnolencia" value="true" checked />}
                else
                {<input type="radio" name="Accidente_por_somnolencia" value="true" />}
            </td>
            <td>
                @if (!Model.Accidente_por_somnolencia)
                {<input type="radio" name="Accidente_por_somnolencia" value="false" checked />}
                else
                {<input type="radio" name="Accidente_por_somnolencia" value="false" />}
            </td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                Accidente con alta sospecha de somnolencia (Criterio 2 positivo)
            </td>
            <td>
                @if (Model.Accidente_con_alta_sospecha)
                {<input type="radio" name="Accidente_con_alta_sospecha" value="true" checked />}
                else
                {<input type="radio" name="Accidente_con_alta_sospecha" value="true" />}
            </td>
            <td>
                @if (!Model.Accidente_con_alta_sospecha)
                {<input type="radio" name="Accidente_con_alta_sospecha" value="false" checked />}
                else
                {<input type="radio" name="Accidente_con_alta_sospecha" value="false" />}
            </td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                Accidente con escasa evidencia/ sospecha por somnolencia (solo 1 ítem de Criterio 2)
            </td>
            <td>
                @if (Model.Accidente_con_escasa_evidencia)
                {<input type="radio" name="Accidente_con_escasa_evidencia" value="true" checked />}
                else
                {<input type="radio" name="Accidente_con_escasa_evidencia" value="true" />}
            </td>
            <td>
                @if (!Model.Accidente_con_escasa_evidencia)
                {<input type="radio" name="Accidente_con_escasa_evidencia" value="false" checked />}
                else
                {<input type="radio" name="Accidente_con_escasa_evidencia" value="false" />}
            </td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                No se dispone de datos suficientes para clasificar el (los) incidentes
            </td>
            <td>
                @if (Model.No_se_dispone_de_datos_suficientes)
                {<input type="radio" name="No_se_dispone_de_datos_suficientes" value="true" checked />}
                else
                {<input type="radio" name="No_se_dispone_de_datos_suficientes" value="true" />}
            </td>
            <td>
                @if (!Model.No_se_dispone_de_datos_suficientes)
                {<input type="radio" name="No_se_dispone_de_datos_suficientes" value="false" checked />}
                else
                {<input type="radio" name="No_se_dispone_de_datos_suficientes" value="false" />}
            </td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                Accidente no debido a somnolencia (información suficiente que descarta la somnolencia)
            </td>
            <td>
                @if (Model.Accidente_no_debido_a_somnolencia)
                {<input type="radio" name="Accidente_no_debido_a_somnolencia" value="true" checked />}
                else
                {<input type="radio" name="Accidente_no_debido_a_somnolencia" value="true" />}
            </td>
            <td>
                @if (!Model.Accidente_no_debido_a_somnolencia)
                {<input type="radio" name="Accidente_no_debido_a_somnolencia" value="false" checked />}
                else
                {<input type="radio" name="Accidente_no_debido_a_somnolencia" value="false" />}
            </td>
        </tr>

    </table>
    @*Entrevista al paciente*@
    <br />
    <h4>3. ENTREVISTA AL PACIENTE:</h4>
    <hr />

    <table>
        <tr>
            <td></td>
            <td width="100%"></td>
            <td style="padding-right:5px;padding-left:5px" class="label-form">SI</td>
            <td style="padding-right:5px;padding-left:5px" class="label-form">NO</td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                En los últimos 5 años, su pareja o esposa le ha comentado que ronca al dormir
            </td>
            <td>
                @if (Model.Su_esposa_comento_que_ronca)
                {<input type="radio" name="Su_esposa_comento_que_ronca" value="true" checked />}
                else
                {<input type="radio" name="Su_esposa_comento_que_ronca" value="true" />}
            </td>
            <td>
                @if (!Model.Su_esposa_comento_que_ronca)
                {<input type="radio" name="Su_esposa_comento_que_ronca" value="false" checked />}
                else
                {<input type="radio" name="Su_esposa_comento_que_ronca" value="false" />}
            </td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                En los últimos 5 años, su pareja o esposa le ha comentado que hacer ruidos al respirar mientras duerme
            </td>
            <td>
                @if (Model.Su_esposa_comento_que_hace_ruidos)
                {<input type="radio" name="Su_esposa_comento_que_hace_ruidos" value="true" checked />}
                else
                {<input type="radio" name="Su_esposa_comento_que_hace_ruidos" value="true" />}
            </td>
            <td>
                @if (!Model.Su_esposa_comento_que_hace_ruidos)
                {<input type="radio" name="Su_esposa_comento_que_hace_ruidos" value="false" checked />}
                else
                {<input type="radio" name="Su_esposa_comento_que_hace_ruidos" value="false" />}
            </td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                En los últimos 5 años, su pareja o esposa le ha comentado que deja de respirar cuando duerme (pausa respiratoria)
            </td>
            <td>
                @if (Model.Su_esposa_comento_que_deja_de_respirar)
                {<input type="radio" name="Su_esposa_comento_que_deja_de_respirar" value="true" checked />}
                else
                {<input type="radio" name="Su_esposa_comento_que_deja_de_respirar" value="true" />}
            </td>
            <td>
                @if (!Model.Su_esposa_comento_que_deja_de_respirar)
                {<input type="radio" name="Su_esposa_comento_que_deja_de_respirar" value="false" checked />}
                else
                {<input type="radio" name="Su_esposa_comento_que_deja_de_respirar" value="false" />}
            </td>
        </tr>
        <tr>
            <td class="label-form"></td>
            <td>
                Comparado con sus compañeros, usted siente que tiene más sueño o cansancio que ellos mientras trabaja
            </td>
            <td>
                @if (Model.Siente_mas_que_tiene_mas_sueno)
