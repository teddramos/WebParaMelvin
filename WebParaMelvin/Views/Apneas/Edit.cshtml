<script>
    var grade = '@Model.Grado'
    function singImage(img) {
        clearSigImage();
        image = document.getElementById(img);
        switch (img) {
            case "grado1":
                image.src = '../../Images/grado1-marked.png'; document.getElementById("grado").value = 1
                break;
            case "grado2":
                image.src = '../../Images/grado2-marked.png'; document.getElementById("grado").value = 2
                break;
            case "grado3":
                image.src = '../../Images/grado3-marked.png'; document.getElementById("grado").value = 3
                break;
            case "grado4":
                image.src = '../../Images/grado4-marked.png'; document.getElementById("grado").value = 4
                break;

        }
        
    }
    function clearSigImage() {
        document.getElementById("grado1").src = '../../Images/grado1.png'
        document.getElementById("grado2").src = '../../Images/grado2.png'
        document.getElementById("grado3").src = '../../Images/grado3.png'
        document.getElementById("grado4").src = '../../Images/grado4.png'
        document.getElementById("grado").value = ''
    }
    function setGradeSelected(grade) {
        switch (grade) {
            case '1': document.getElementById("grado1").src = '../../Images/grado1-marked.png'
                break;
            case '2': document.getElementById("grado2").src = '../../Images/grado2-marked.png'
                break;
            case '3': document.getElementById("grado3").src = '../../Images/grado3-marked.png'
                break;
            case '4': document.getElementById("grado4").src = '../../Images/grado4-marked.png'
                break;
        }
    }
    setGradeSelected(grade)
</script>
