    <div class="form-group">
        @Html.LabelFor(model => model.Siente_mas_que_tiene_mas_sueno, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <div class="checkbox">
                @Html.EditorFor(model => model.Siente_mas_que_tiene_mas_sueno)
                @Html.ValidationMessageFor(model => model.Siente_mas_que_tiene_mas_sueno, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Tiene_familiar_con_apnea, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <div class="checkbox">
                @Html.EditorFor(model => model.Tiene_familiar_con_apnea)
                @Html.ValidationMessageFor(model => model.Tiene_familiar_con_apnea, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Accidente_por_falla_humana, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
            <div class="checkbox">
                @Html.EditorFor(model => model.Accidente_por_falla_humana)
                @Html.ValidationMessageFor(model => model.Accidente_por_falla_humana, "", new { @class = "text-danger" })
            </div>
        </div>
    </div>

    <div class="form-group">
        @Html.LabelFor(model => model.Recibe_tratamiento_para_apnea, htmlAttributes: new { @class = "control-label col-md-2" })
        <div class="col-md-10">
