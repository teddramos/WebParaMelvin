                                @if (!apn.Se_le_ha_relizado_una_PSG)
                                {<input type="radio" name="Se_le_ha_relizado_una_PSG" value="false" checked />}
                                else
                                {<input type="radio" name="Se_le_ha_relizado_una_PSG" value="false" />}
                            </td>
                        </tr>
                    </table>
                    <br />
                    <h4>PUNTUACIÓN DE LA ESCALA DE EPWORTH (ESS) </h4>
                    <h5>(Nunca=0, poca=1, moderada=2, alta=3) </h5>

                    <div class="form-group">
                        @Html.Label("Total puntos (sumatoria) >10** ", htmlAttributes: new { @class = "label-form col-md-2" }): @apn.Puntuacion_epwhorth

                    </div>
                    <br />
                    <br />
                    <h4>4. EXÁMEN FÍSICO: </h4>
                    <hr />
                    <table width="100%">
                        <tr>
                            <td width="100"> @Html.Label("Peso (kg):", htmlAttributes: new { @class = "label-form col-md-3" })</td>
                            <td>@apn.Peso</td>
                            <td width="100">@Html.Label("Talla (mts):", htmlAttributes: new { @class = "label-form col-md-3" })</td>
                            <td>@apn.Talla</td>
                            <td> @Html.Label("IMC (Kg/m2):", htmlAttributes: new { @class = "label-form col-md-3" })</td>
                            <td>@apn.IMC</td>
                            <td>@Html.Label("Circunferencia de cuello:", htmlAttributes: new { @class = "label-form col-md-3" })</td>
                            <td> @apn.Circunferencia_de_cuello</td>
                        </tr>
                        <tr>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td><span>(> 35 es de alto riesgo)</span></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td>  @Html.Label("Varón Normal:", htmlAttributes: new { @class = "label-form col-md-3" }) <span>(menor de 43, 2 cm, es normal)</span>
                            </td>
                            <td>
                                <span>
                                    Si
                                    @if (apn.Varon_normal)
                                    {<input type="radio" name="Varon_normal" value="true" checked />}
                                    else
                                    {<input type="radio" name="Varon_normal" value="true" />}
                                </span>
                                <span>
                                    No
                                    @if (!apn.Varon_normal)
                                    {<input type="radio" name="Varon_normal" value="false" checked />}
                                    else
                                    {<input type="radio" name="Varon_normal" value="false" />}
                                </span>
                            </td>
                            <td>@Html.Label("Mujer Normal:", htmlAttributes: new { @class = "label-form col-md-3" }) <span>(menor de 40.6 cm, es normal)</span></td>
                            <td>
                                <span>
                                    Si
                                    @if (apn.Mujer_normal)
                                    {<input type="radio" name="Mujer_normal" value="true" checked />}
                                    else
                                    {<input type="radio" name="Mujer_normal" value="true" />}
                                </span>
                                <span>
                                    No
                                    @if (!apn.Mujer_normal)
                                    {<input type="radio" name="Mujer_normal" value="false" checked />}
                                    else
                                    {<input type="radio" name="Mujer_normal" value="false" />}
                                </span>
                            </td>
                            <td>@Html.Label("P. Sistólica:", htmlAttributes: new { @class = "label-form col-md-3" })</td>
                            <td>@apn.Sistolica</td>
                            <td> @Html.Label("P. Diastólica:", htmlAttributes: new { @class = "label-form col-md-3" })</td>
                            <td>@apn.Diastolica</td>
                        </tr>
                        <tr>
                            <td>@Html.Label("HTA nueva:", htmlAttributes: new { @class = "label-form col-md-3" })</td>
                            <td>
                                <span>
                                    Si
                                    @if (apn.HTA_nueva)
                                    {<input type="radio" name="HTA_nueva" value="true" checked />}
                                    else
                                    {<input type="radio" name="HTA_nueva" value="true" />}
                                </span>
                                <span>
                                    No
                                    @if (!apn.Mujer_normal)
                                    {<input type="radio" name="HTA_nueva" value="false" checked />}
                                    else
                                    {<input type="radio" name="HTA_nueva" value="false" />}
                                </span>
                            </td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                            <td></td>
                        </tr>
                    </table>
                   <br />

                    <h4>Evaluación de vía aérea superior MALLAMPATI (marque con una X) </h4>
                    <br />
                    <table cellpadding="20">
                        <tr>
                            <td width="50"></td>
                            <td><img id="grado1" src="../../Images/grado1.png" width="150" onclick="singImage('grado1')"></td>
                            <td><img id="grado2" src="../../Images/grado2.png" width="150" onclick="singImage('grado2')"></td>
                            <td><img id="grado3" src="../../Images/grado3.png" width="150" onclick="singImage('grado3')"></td>
                            <td><img id="grado4" src="../../Images/grado4.png" width="150" onclick="singImage('grado4')"></td>
                            <td width="50"></td>
                        </tr>
                        <tr>
                            <td width="50"></td>
                            <td align="center">Grado I</td>
                            <td align="center">Grado II</td>
                            <td align="center">Grado III</td>
                            <td align="center">Grado IV</td>
                            <td width="50"></td>
                        </tr>
                        <tr>
                            <td width="50"></td>
                            <td align="center"></td>
                            <td align="center" colspan="2"></td>
                            <td align="center"></td>
                            <td width="50"></td>
                        </tr>
                    </table>
                    
                    <br />
                    <h4>5. CONCLUSIÓN DE LA EVALUACIÓN</h4>
                    <hr />
                    <table width="100%">
                        <tr>
                            <td colspan="3">*Ampliación: oximetría, polisomnografía, seguimiento tratamiento, interconsulta</td>
                            <td align="center"><strong>SI</strong></td>
                            <td align="center"><strong>NO</strong></td>
                        </tr>
                        <tr>
                            <td width="400" colspan="2"><h4>RIESGO ALTO:</h4></td>
                            <td>(criterio A o B positivo)</td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td width="75"></td>
                            <td><strong>Criterio A:</strong></td>
                            <td>
                                Excesiva somnolencia (Epworth > 15 o cabeceo presenciado durante espera), incidente por somnolencia o con alta sospecha (último año)
                            </td>
                            <td>
                                @if (apn.Excesiva_somnolencia)
                                {<input type="radio" name="Excesiva_somnolencia" value="true" checked />}
                                else
                                {<input type="radio" name="Excesiva_somnolencia" value="true" />}
                            </td>
                            <td>
                                @if (!apn.Excesiva_somnolencia)
                                {<input type="radio" name="Excesiva_somnolencia" value="false" checked />}
                                else
                                {<input type="radio" name="Excesiva_somnolencia" value="false" />}
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td><strong>Criterio B:</strong></td>
                            <td>
                                Antecedente de SAS sin control reciente o sin cumplimiento de tratamiento (con CPAP o cirugía)
                            </td>
                            <td>
                                @if (apn.Antecendente_de_SAS)
                                {<input type="radio" name="Antecendente_de_SAS" value="true" checked />}
                                else
                                {<input type="radio" name="Antecendente_de_SAS" value="true" />}
                            </td>
                            <td>
                                @if (!apn.Antecendente_de_SAS)
                                {<input type="radio" name="Antecendente_de_SAS" value="false" checked />}
                                else
                                {<input type="radio" name="Antecendente_de_SAS" value="false" />}
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5" style="background-color:lightgrey">
                                <strong><u>Acción requerida:</u></strong> en <strong>RIESGO ALTO</strong>, el paciente requiere pruebas ampliatorias (oximetría, PSG o certificación de cumplimiento de tratamiento de apnea del sueño)
                            </td>
                        </tr>

                        <tr>
                            <td width="150" colspan="2"><h4>RIESGO MEDIO:</h4></td>
                            <td>(Criterio C, D o E positivo)</td>
                            <td></td>
                            <td></td>
                        </tr>
                        <tr>
                            <td></td>
                            <td><strong>Criterio C:</strong></td>
                            <td>
                                Historia de higiene de sueño sugiere SAS (ronquidos + pausas respiratorias + Epworth >10)
                            </td>
                            <td>
                                @if (apn.Historia_de_higiene)
                                {<input type="radio" name="Historia_de_higiene" value="true" checked />}
                                else
                                {<input type="radio" name="Historia_de_higiene" value="true" />}
                            </td>
                            <td>
                                @if (!apn.Historia_de_higiene)
                                {<input type="radio" name="Historia_de_higiene" value="false" checked />}
                                else
                                {<input type="radio" name="Historia_de_higiene" value="false" />}
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td><strong>Criterio D:</strong></td>
                            <td>
                                Cumple con 2 o más de los siguientes: IMC mayor o igual a <span style="color:red">30</span> Hipertensión Arterial (nueva o no controlada con una sola medicación) Circunferencia del cuello anormal Puntuación de Epworth mayor de 10 y menor de 16 Antecedente de trastorno del sueño (diagnosticado) sin seguimiento Índice de ápnea-hipopnea (AHI) mayor de 5 y menor de 30
                            </td>
                            <td>
                                @if (apn.Cumple_con_dos_o_mas)
                                {<input type="radio" name="Cumple_con_dos_o_mas" value="true" checked />}
                                else
                                {<input type="radio" name="Cumple_con_dos_o_mas" value="true" />}
                            </td>
                            <td>
                                @if (!apn.Historia_de_higiene)
                                {<input type="radio" name="Cumple_con_dos_o_mas" value="false" checked />}
                                else
                                {<input type="radio" name="Cumple_con_dos_o_mas" value="false" />}
                            </td>
                        </tr>
                        <tr>
                            <td></td>
                            <td><strong>Criterio E:</strong></td>
                            <td>
                                Evaluación de vía aérea superior patológico*(Mallampati III o IV)
                            </td>
                            <td>
                                @if (apn.Evaluacion_via_aerea)
                                {<input type="radio" name="Evaluacion_via_aerea" value="true" checked />}
                                else
                                {<input type="radio" name="Evaluacion_via_aerea" value="true" />}
                            </td>
                            <td>
                                @if (!apn.Evaluacion_via_aerea)
                                {<input type="radio" name="Evaluacion_via_aerea" value="false" checked />}
                                else
                                {<input type="radio" name="Evaluacion_via_aerea" value="false" />}
                            </td>
                        </tr>
                        <tr>
                            <td colspan="5" style="background-color:lightgrey">
                                <strong><u>Acción requerida:</u></strong> en <strong>RIESGO MEDIO</strong>, el paciente TIENE 3 MESES de aptitud TEMPORAL. Requiere pruebas ampliatorias (oximetría, PSG o certificación de cumplimiento de tratamiento de apnea del sueño) antes de emitir aptitud por 12 meses
                            </td>
                        </tr>
                        <tr>
                            <td width="150" colspan="2"><h4>RIESGO BAJO:</h4></td>
                            <td><strong>Apto para conducir vehículos (ningún criterio positivo</strong></td>
                            <td>
                                @if (apn.Apto_para_conducir_vehiculos)
                                {<input type="radio" name="Apto_para_conducir_vehiculos" value="true" checked />}
                                else
                                {<input type="radio" name="Apto_para_conducir_vehiculos" value="true" />}
                            </td>
                            <td>
                                @if (!apn.Apto_para_conducir_vehiculos)
                                {<input type="radio" name="Apto_para_conducir_vehiculos" value="false" checked />}
                                else
                                {<input type="radio" name="Apto_para_conducir_vehiculos" value="false" />}
                            </td>
                        </tr>
                    </table>



                    <div class="form-group">
                        @Html.Label("Firma Especialista:", htmlAttributes: new { @class = "label-form col-md-2" })
                        <table>
                            <tr>
                                <td></td>
                                <td style="border-bottom:solid">
                                    @{
                                        try
                                        {
                                            var base64 = Convert.ToBase64String(apn.Firma);
                                            var imgSrc = String.Format("data:image/jpeg;base64,{0}", base64);
                                            <img src="@imgSrc" />
                                        }
                                        catch
                                        {

                                        }
                                    }
                                </td>
                            </tr>
                        </table>
                        
                        
                    </div>
                    <script>
                        var grade = '@apn.Grado'
                        function setGradeSelected(grade) {
                            switch (grade) {
                                case '1': document.getElementById("grado1").src = '../../Images/grado1-marked.png'
                                    break;
                                case '2': document.getElementById("grado2").src = '../../Images/grado2-marked.png'
                                    break;
                                case '3': document.getElementById("grado3").src = '../../Images/grado3-marked.png'
                                    break;
                                case '4': document.getElementById("grado4").src = '../../Images/grado4-marked.png'
                                    break;
                            }
                        }
                        setGradeSelected(grade)
                    </script>
                </div>
                }
            }
            </body>
</html>
